# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable / anon key for the browser client (never use the service role here)
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Optional Sentry DSN; leave blank to disable error reporting
VITE_SENTRY_DSN=https://YOUR_PUBLIC_KEY@o0.ingest.sentry.io/0

# Optional release override (Vercel builds inject VERCEL_GIT_COMMIT_SHA automatically via Vite)
# VITE_APP_RELEASE=abc1234

# Optional: true only if Supabase Image Transformations are enabled (Pro+)
VITE_SUPABASE_IMAGE_TRANSFORM=false
