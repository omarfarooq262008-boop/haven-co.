# Public site URL (no trailing slash) — used for sitemap absolute URLs
VITE_SITE_URL=https://your-production-domain.example

# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable / anon key for the browser client (never use the service role here)
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Optional Sentry DSN; leave blank to disable error reporting (app works without it)
VITE_SENTRY_DSN=https://YOUR_PUBLIC_KEY@o0.ingest.sentry.io/0

# Optional release override (Vercel builds inject VERCEL_GIT_COMMIT_SHA automatically via Vite)
# VITE_APP_RELEASE=abc1234

# Build-time only (Vercel env — never VITE_*). When all three are set, the Vite build
# uploads hidden source maps to Sentry and deletes them from dist/ so they stay private.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug

# Optional: true only if Supabase Image Transformations are enabled (Pro+)
VITE_SUPABASE_IMAGE_TRANSFORM=false
